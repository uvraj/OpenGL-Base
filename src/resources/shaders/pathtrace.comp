#version 460

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout (rgba32f) uniform image2D reservoirVisPos;
layout (rgba32f) uniform image2D reservoirVisNormal;
layout (rgba32f) uniform image2D reservoirHitPos;
layout (rgba32f) uniform image2D reservoirHitNormal;
layout (rgba32f) uniform image2D reservoirRadiance;
layout (rgba32f) uniform image2D reservoirMisc;

layout (rgba32f) uniform image2D tracedRadiance;

uniform sampler2D reservoirVisPosPrev;
uniform sampler2D reservoirVisNormalPrev;
uniform sampler2D reservoirHitPosPrev;
uniform sampler2D reservoirHitNormalPrev;
uniform sampler2D reservoirRadiancePrev;
uniform sampler2D reservoirMiscPrev;

uniform mat4 cameraProjectionMatrix;
uniform mat4 cameraViewMatrix;
uniform mat4 cameraProjectionMatrixInverse;
uniform mat4 cameraViewMatrixInverse;

uniform mat4 previousCameraProjectionMatrixInverse;
uniform mat4 previousCameraViewMatrixInverse;

uniform vec3 cameraPosition;
uniform vec3 previousCameraPosition;

uniform float currentFrame;

uniform bool shouldAccumulate;

#include "lib/utility.glsl"
#include "lib/intersections.glsl"

vec2 Rand(vec2 n) { 
	return vec2(
        clamp(fract(sin(dot(n + fract(currentFrame), vec2(12.9898, 4.1414))) * 43758.5453), 0.0, 1.0),
        clamp(fract(cos(dot(n - fract(currentFrame), vec2(12.9898, 4.1414))) * 43758.5453), 0.0, 1.0)
    );
}

void CompareHitData(inout HitData hitData, HitData newHitData) {
    if (abs(newHitData.t) < abs(hitData.t) && newHitData.rayHit) hitData = newHitData;
}

void RayTrace(out HitData hitData, const vec3 rayOrigin, const vec3 rayDirection) {
    Material planeMaterial = emptyMaterial;
    planeMaterial.albedo = vec3(1.0f, 1.0f, 1.0f);
    planeMaterial.emissivity = 0.0f;
    planeMaterial.isEmissive = false;

    Material emitterMaterial = emptyMaterial;
    emitterMaterial.albedo = vec3(1.0f, 1.0f, 1.0f);
    emitterMaterial.emissivity = 5.0f;
    emitterMaterial.isEmissive = true;

    hitData = emptyHitData;
    HitData hitDataTemp = emptyHitData;
    IntersectPlane(hitDataTemp, planeMaterial, vec3(0.0f, -1.0f, 0.0f), vec3(0.0f, 1.0f, 0.0f), rayOrigin, rayDirection);
    CompareHitData(hitData, hitDataTemp);

    hitDataTemp = emptyHitData;
    IntersectPlane(hitDataTemp, planeMaterial, vec3(0.0f, 1.0f, 0.0f), vec3(0.0f, -1.0f, 0.0f), rayOrigin, rayDirection);
    CompareHitData(hitData, hitDataTemp);

    hitDataTemp = emptyHitData;
    planeMaterial.albedo = vec3(1.0f, 0.0f, 0.0f);
    IntersectPlane(hitDataTemp, planeMaterial, vec3(-1.0f, 0.0f, 0.0f), vec3(1.0f, 0.0f, 0.0f), rayOrigin, rayDirection);
    CompareHitData(hitData, hitDataTemp);

    hitDataTemp = emptyHitData;
    planeMaterial.albedo = vec3(0.0f, 1.0f, 0.0f);
    IntersectPlane(hitDataTemp, planeMaterial, vec3(1.0f, 0.0f, 0.0f), vec3(-1.0f, 0.0f, 0.0f), rayOrigin, rayDirection);
    CompareHitData(hitData, hitDataTemp);

    hitDataTemp = emptyHitData;
    planeMaterial.albedo = vec3(1.0f);
    IntersectPlane(hitDataTemp, planeMaterial, vec3(0.0f, 0.0f, -1.0f), vec3(0.0f, 0.0f, 1.0f), rayOrigin, rayDirection);
    CompareHitData(hitData, hitDataTemp);

    hitDataTemp = emptyHitData;
    planeMaterial.albedo = vec3(1.0f);
    IntersectSphere(hitDataTemp, planeMaterial, vec3(-0.5f, -0.66f, 0.5f), 0.33f, rayOrigin, rayDirection);
    CompareHitData(hitData, hitDataTemp);

    hitDataTemp = emptyHitData;
    planeMaterial.albedo = vec3(1.0f);
    IntersectSphere(hitDataTemp, planeMaterial, vec3(0.00f, -0.66f, 0.0f), 0.33f, rayOrigin, rayDirection);
    CompareHitData(hitData, hitDataTemp);

    hitDataTemp = emptyHitData;
    planeMaterial.albedo = vec3(1.0f);
    IntersectSphere(hitDataTemp, planeMaterial, vec3(0.5f, -0.66f, 0.5f), 0.33f, rayOrigin, rayDirection);
    CompareHitData(hitData, hitDataTemp);

    hitDataTemp = emptyHitData;
    planeMaterial.albedo = vec3(1.0f);
    planeMaterial.isMetal = true;
    IntersectDisk(hitDataTemp, planeMaterial, vec3(0.0, -0.8, 2.0f), 0.2f, vec3(0.0f, 0.0f, -1.0f), rayOrigin, rayDirection);
    hitDataTemp.hitNormal.x += 0.2 * sin(distance(hitDataTemp.hitPos.xy, vec2(0.0, -0.8)) * 100);
    hitDataTemp.hitNormal = normalize(hitDataTemp.hitNormal); 

    CompareHitData(hitData, hitDataTemp);

    IntersectDisk(hitDataTemp, emitterMaterial, vec3(0.0f, 0.99f, 0.0f), 0.5f, vec3(0.0f, -1.0f, 0.0f), rayOrigin, rayDirection);
    CompareHitData(hitData, hitDataTemp);
}

void RayTraceScene(out HitData hitData, const vec3 rayOrigin, const vec3 rayDirection) {
    RayTrace(hitData, rayOrigin, rayDirection);

    if (hitData.material.isMetal) {
        RayTrace(hitData, hitData.hitPos + vec3(0.0001) * hitData.hitNormal, reflect(rayDirection, hitData.hitNormal));
    }

    /*if (hitData.material.isMetal) {
        RayTrace(hitData, hitData.hitPos - vec3(0.01) * hitData.hitNormal, refract(rayDirection, hitData.hitNormal, 1.0 / 1.450));

        if (hitData.material.isMetal) {
            RayTrace(hitData, hitData.hitPos + vec3(0.01) * hitData.hitNormal, refract(rayDirection, -hitData.hitNormal, 1.450));
        }
    }*/
}

vec3 CalculateCameraRayDir(const vec2 nCoord, const mat4 projectionMatrixInverse, const mat4 viewMatrixInverse) {
    vec3 rayDir = vec3(nCoord, 1.0) * 2.0 - 1.0;
    vec4 tmp = projectionMatrixInverse * vec4(rayDir, 1.0);
         rayDir = tmp.xyz / tmp.w;
         rayDir = mat3(viewMatrixInverse) * rayDir;
         rayDir = normalize(rayDir);
    
    return rayDir;
}

struct Sample {
    vec3 visPos;
    vec3 visNormal;
    vec3 hitPos;
    vec3 hitNormal;
    vec3 radiance;
};

struct Reservoir {
    Sample z;
    float w;
    float M;
    float W;
};

void ReadReservoir(inout Reservoir R, ivec2 iPos) {
    R.z.visPos      = texelFetch(reservoirVisPosPrev, iPos, 0).rgb;
    R.z.visNormal   = texelFetch(reservoirVisNormalPrev, iPos, 0).rgb;
    R.z.hitPos      = texelFetch(reservoirHitPosPrev, iPos, 0).rgb;
    R.z.hitNormal   = texelFetch(reservoirHitNormalPrev, iPos, 0).rgb;
    R.z.radiance    = texelFetch(reservoirRadiancePrev, iPos, 0).rgb;

    R.w             = texelFetch(reservoirMiscPrev, iPos, 0).r;
    R.M             = texelFetch(reservoirMiscPrev, iPos, 0).g;
    R.W             = texelFetch(reservoirMiscPrev, iPos, 0).b;
}

void UpdateReservoir(inout Reservoir R, Sample newSample, float wNew, float rand) {
    R.w += wNew;
    R.M += 1;

    if (rand < wNew / R.w) {
        R.z = newSample;
    }
}

void WriteReservoir(Reservoir R, ivec2 iPos) {
    imageStore(reservoirVisPos,      iPos, vec4(R.z.visPos,     0.0));
    imageStore(reservoirVisNormal,   iPos, vec4(R.z.visNormal,  0.0));
    imageStore(reservoirHitPos,      iPos, vec4(R.z.hitPos,     0.0));
    imageStore(reservoirHitNormal,   iPos, vec4(R.z.hitNormal,  0.0));
    imageStore(reservoirRadiance,    iPos, vec4(R.z.radiance,   0.0));
    
    // Pack w, M, W into .rgb of one texture
    imageStore(reservoirMisc, iPos, vec4(R.w, R.M, R.W, 0.0));
}

void main() {
    /*
    WHOEVER YOU ARE: 
    please do *not* scrutinize this code. it is likely incorrect in many places, and I can't be bothered taking this any further atm.
    */

    ivec2 iPos = ivec2(gl_GlobalInvocationID.xy);
    vec2 nCoord = (iPos + 0.5) / (gl_NumWorkGroups.xy * gl_WorkGroupSize.xy);

    // Camera ray
    vec3 rayDir = CalculateCameraRayDir(nCoord, cameraProjectionMatrixInverse, cameraViewMatrixInverse);
    vec3 rayPos = cameraPosition;

    HitData hitData = emptyHitData;
    RayTraceScene(hitData, rayPos, rayDir);

    if (!hitData.rayHit || hitData.material.isEmissive) {
        imageStore(tracedRadiance, iPos, vec4(hitData.material.emissivity * hitData.material.albedo, 0.0));
        return;
    }

    // ReSTIR GI - sample one indirect bounce
    vec3 normal = hitData.hitNormal;
    vec3 albedo = hitData.material.albedo;

    vec2 rand = Rand(nCoord);
    vec3 sampleDir = UniformSampleHemisphere(normal, rand);
    float cosTheta = max(dot(sampleDir, normal), 0.0);
    float pdf = 1.0 / PI;

    // Trace indirect bounce
    HitData indirectHit = emptyHitData;
    RayTraceScene(indirectHit, hitData.hitPos + normal * 0.001, sampleDir);

    vec3 radiance = vec3(0.0);
    if (indirectHit.rayHit && indirectHit.material.isEmissive) {
        radiance = indirectHit.material.emissivity * indirectHit.material.albedo;
    }

    vec3 secondaryRadiance = vec3(0.0);

    if (indirectHit.rayHit && !indirectHit.material.isEmissive) {
        HitData secondaryHit = emptyHitData;
        sampleDir = UniformSampleHemisphere(indirectHit.hitNormal, Rand(nCoord + vec2(PI, 1.0 / PI)));
        RayTraceScene(secondaryHit, indirectHit.hitPos + indirectHit.hitNormal * 0.001, sampleDir);

        if (secondaryHit.rayHit && secondaryHit.material.isEmissive) {
            secondaryRadiance = indirectHit.material.albedo * secondaryHit.material.emissivity * secondaryHit.material.albedo * dot(sampleDir, indirectHit.hitNormal);
        }
    }

    radiance += secondaryRadiance;
    radiance *= albedo * dot(hitData.hitNormal, sampleDir);
    vec3 f = radiance;
    float weight = length(f);

    Sample newSample;
    newSample.visPos    = hitData.hitPos;
    newSample.visNormal = hitData.hitNormal;
    newSample.hitPos    = indirectHit.hitPos;
    newSample.hitNormal = indirectHit.hitNormal;
    newSample.radiance  = f;

    Reservoir reservoir;
    ReadReservoir(reservoir, iPos);

    UpdateReservoir(reservoir, newSample, weight, Rand(nCoord + vec2(PI, 1.0 / PI)).x);

    float norm = length(reservoir.z.radiance);
    reservoir.W = (norm > 0.0) ? reservoir.w / (reservoir.M * norm) : 0.0;

    if (!shouldAccumulate) {
        reservoir.M = 0;
        reservoir.w = 0;
        reservoir.W = 0;
        reservoir.z.radiance = vec3(0.0);
    }

    WriteReservoir(reservoir, iPos);

    vec3 finalRadiance = reservoir.z.radiance * reservoir.W;
    imageStore(tracedRadiance, iPos, vec4(finalRadiance, 0.0));
}

